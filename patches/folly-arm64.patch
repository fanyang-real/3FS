+uint32_t crc32c_hw(const uint8_t* buf, size_t len, uint32_t crc) {
+  while (len && (reinterpret_cast<uintptr_t>(buf) & 7)) {
+    crc = __crc32cb(crc, *buf++);
+    --len;
+  }
+  for (; len >= 8; len -= 8, buf += 8) {
+    uint64_t v;
+    std::memcpy(&v, buf, sizeof(v));
+    crc = __crc32cd(crc, v);
+  }
+  while (len--) {
+    crc = __crc32cb(crc, *buf++);
+  }
+  return crc;
+}
